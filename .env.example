# Bonsai Local Workforce — environment configuration
# Copy to .env and adjust. Never commit .env (it is gitignored).
# Every value here is environment-overridable; scripts source .env when present.

# --- Bonsai model server (PrismML llama.cpp fork) ---
BONSAI_LLAMA_SERVER=/home/plasmion/git/bonsai/llama.cpp/build/bin/llama-server
BONSAI_MODEL=/media/plasmion/Models/ternary_bonsai/Ternary-Bonsai-2-27B-PQ2_0.gguf
BONSAI_MMPROJ=/media/plasmion/Models/ternary_bonsai/Ternary-Bonsai-2-27B-mmproj-Q8_0.gguf
BONSAI_HOST=127.0.0.1
BONSAI_PORT=8091
BONSAI_BASE_URL=http://127.0.0.1:8091
# Profiles: benchmark -> 16384, agent -> 65536 (use 32768 only if 65536 is
# unstable on this GPU; context is never silently altered by tooling).
BONSAI_PROFILE=benchmark
BONSAI_CTX_BENCHMARK=16384
BONSAI_CTX_AGENT=65536
BONSAI_NGL=99
BONSAI_FLASH_ATTN=on
BONSAI_THREADS=4
BONSAI_PARALLEL=1
# Optional variant models (see scripts/start-bonsai.sh)
# BONSAI_MODEL_ALIAS=bonsai-local
# Extra flags appended verbatim to llama-server (validated by doctor.sh):
# BONSAI_EXTRA_ARGS=

# --- Agent ---
BONSAI_MODEL_ID=Ternary-Bonsai-2-27B-PQ2_0
BONSAI_TIMEOUT=900
BONSAI_WORKSPACE=.

# --- Hermes execution harness ---
HERMES_PORT=8642
HERMES_KEY=bonsai-local
# OPENAI_API_KEY is a dummy for the local endpoint; never a real secret here.
OPENAI_API_KEY=local
OPENAI_BASE_URL=http://127.0.0.1:8091/v1
HERMES_ENV_FILE=$HOME/.hermes/.env.bonsai-local

# --- Paperclip control plane ---
PAPERCLIP_CMD=npx paperclipai
PAPERCLIP_WORKDIR=$HOME/.paperclip

# --- Reliability knobs ---
BONSAI_CONNECT_TIMEOUT=10
BONSAI_READ_TIMEOUT=900
BONSAI_MAX_RETRIES=5
BONSAI_BACKOFF_BASE=1.0
BONSAI_BACKOFF_CAP=30.0

# --- Paths ---
LOG_DIR=.logs
STATE_DIR=.agent
